{
    "layer": "top",
    "position": "top",
    "margin-top": 12,
    "margin-left": 12,
    "margin-right": 12,
    "height": 48,
    "modules-left": [
        "cpu",
        "memory",
        "temperature",
        "custom/uptime",
        "power-profiles-daemon"

    ],
     "modules-right": [
        "bluetooth",
        "pulseaudio",
        "network",
        "battery",
        "clock"
    ],
    "clock": {
        "format": "{:%I:%M %p %m/%d/%Y}",
        "interval": 1
    },
    "network": {
        "format-wifi": "[ {essid} ({signalStrength}%) ]",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "[ Disconnected ⚠ ]",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "[ Volume: {volume}% ] [ {format_source} ]",
        "format-bluetooth": "{volume}% {format_source}",
        "format-bluetooth-muted": "Bluetooth {icon} {format_source}",
        "format-muted": "[ Volume: Muted ] [ {format_source} ]",
        "format-source": "Mic: On",
        "format-source-muted": "Mic: Off",
        "on-click": "/home/garden/.local/bin/toggle-mic"
    },
    "cpu": {
        "format": "[ CPU: {usage}% ]",
        "tooltip": false
    },
    "memory": {
        "format": "[ RAM: {}% ]"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "[ Temp: {temperatureC}°C ]"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "[ {capacity}% ]",
        "format-full": "[ {capacity}% ]",
        "format-charging": "[ ⌁ {capacity}% ]",
        "format-plugged": "[ {capacity}% ]",
        "format-alt": "{time} {icon}"
    },
    "power-profiles-daemon": {
      "format": "[ Mode: {icon} ]",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "Default",
        "performance": "Performance",
        "balanced": "Balanced",
        "power-saver": "Saver"
      }
    },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "/usr/share/waybar/custom_modules/power_menu.xml",
        "menu-actions": {
            "shutdown": "qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout",
            "reboot": "qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndReboot",
            "sleep": "systemctl suspend"
        }
    },
    "bluetooth": {
        "format": "[ Bluetooth: {status} ]",
        "format-disabled": "[ Bluetooth Disabled ]",
        "format-no-controller": "No bluetooth controller...",
        "format-on": "[ Bluetooth Enabled ]",
        "format-connected": "[ Bluetooth: {num_connections} device ]",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },
    "custom/uptime": {
        "format": "[ Up: {} ]",
        "interval": 1,
        "exec": "awk '{s=int($1); printf \"%d:%02d:%02d\\n\", s/3600, (s%3600)/60, s%60}' /proc/uptime",
        "tooltip": false
    }
}

